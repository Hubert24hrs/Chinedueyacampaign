# ==============================================================================
# HON. CHINEDU EYA CAMPAIGN PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file to .env.local and populate with your production credentials:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. CORE SITE SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://chinedueya.ng
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. ANTI-BOT PROTECTION (Cloudflare Turnstile - Recommended Free Tier)
# ------------------------------------------------------------------------------
# Obtain keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAILS (Resend - Free Tier 3,000 emails/month)
# ------------------------------------------------------------------------------
# Used to send volunteer welcome emails, donor pledge notifications, and office alerts
# Obtain API key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
NOTIFICATION_EMAIL=alerts@chinedueya.ng
FROM_EMAIL="Hon. Chinedu Eya Campaign <no-reply@chinedueya.ng>"

# ------------------------------------------------------------------------------
# 4. DATABASE & CLOUD STORAGE (Supabase - Optional for volunteer / donor slips)
# ------------------------------------------------------------------------------
# Obtain at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 5. ONLINE PAYMENT GATEWAYS (Optional - set features.onlinePayment=true in site.config.ts)
# ------------------------------------------------------------------------------
# Paystack (https://dashboard.paystack.com/#/settings/developer)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Flutterwave (https://app.flutterwave.com/dashboard/settings/apis)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key_here

# ------------------------------------------------------------------------------
# 6. ANALYTICS (Optional - set features.analytics to 'plausible' or 'ga4')
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=chinedueya.ng
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
